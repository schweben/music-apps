{
  "routes": [
    {
      "route": "/music",
      "redirect": "/music/",
      "statusCode": 301
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
        "/assets/*",
        "/*.css",
        "/*.js",
        "/*.map",
        "/*.ico",
        "/*.png",
        "/*.svg",
        "/*.jpg",
        "/*.jpeg",
        "/*.webp",
        "/*.gif"
    ]
  }
}
